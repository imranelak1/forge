# Generate .env with `node scripts/configure.mjs`, or upgrade an existing file
# with `node scripts/configure.mjs --upgrade`. Never commit .env.
COMPOSE_PROJECT_NAME=forge
FORGE_ENVIRONMENT=development
FORGE_LOG_LEVEL=INFO
FORGE_DATABASE_NAME=forge
FORGE_DATABASE_HOST=127.0.0.1
FORGE_DATABASE_PORT=15432
FORGE_DATABASE_PASSWORD=
FORGE_MIGRATION_PASSWORD=
POSTGRES_PASSWORD=
# Independent signing key; never reuse a database password.
FORGE_AUTH_SECRET=
FORGE_PUBLIC_ORIGIN=http://localhost:3000
# Development sends mail to ignored .local/mail/*.eml. Production requires SMTP.
FORGE_MAIL_BACKEND=file
FORGE_MAIL_DIRECTORY=.local/mail
FORGE_SMTP_HOST=
FORGE_SMTP_PORT=587
FORGE_SMTP_USERNAME=
FORGE_SMTP_PASSWORD=
FORGE_SMTP_FROM=Forge <noreply@forge.local>
# Generated from host IDs on Linux so the non-root API can write the local outbox.
FORGE_RUNTIME_UID=10001
FORGE_RUNTIME_GID=10001
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=15432
