{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace @forge/web",
    "build": "npm run build --workspace @forge/web",
    "start": "npm run start --workspace @forge/web",
    "lint": "npm run lint --workspace @forge/web",
    "typecheck": "npm run typecheck --workspace @forge/web",
    "test": "npm run test --workspace @forge/web",
    "test:e2e": "npm run test:e2e --workspace @forge/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.8"
  }
}
